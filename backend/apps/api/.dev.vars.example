# Copy to backend/apps/api/.dev.vars for local Wrangler testing.
# Never commit .dev.vars or real secrets.

# Runtime modes: local | firebase, local | r2
AUTH_MODE=local
STORAGE_MODE=local

# Operational limits (defaults match wrangler.jsonc)
CLOUD_MEDIA_QUOTA_PER_APARTMENT=250
PRESIGN_PUT_TTL_SECONDS=900
PRESIGN_GET_TTL_SECONDS=3600
ABANDONED_PENDING_UPLOAD_TTL_SECONDS=86400
INVITE_CODE_RATE_LIMIT_MAX_ATTEMPTS=5
INVITE_CODE_RATE_LIMIT_WINDOW_SECONDS=900
JPEG_MAX_DIMENSION_PX=3000
JPEG_QUALITY=0.8
JPEG_MAX_BYTES=3145728
MIN_SUPPORTED_APP_VERSION=1.0.0

# Production Firebase Auth secrets (required when AUTH_MODE=firebase)
# FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@replace-with-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# Production Apple Sign-In revocation secrets (required when AUTH_MODE=firebase)
# APPLE_TEAM_ID=REPLACE123
# APPLE_CLIENT_ID=pl.stanmieszkania.app
# APPLE_KEY_ID=REPLACE456
# APPLE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# Production Cloudflare R2 EU S3 API secrets (required when STORAGE_MODE=r2)
# R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# R2_BUCKET_NAME=stanmieszkania-media-production
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
